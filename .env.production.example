NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1

# Server-only URL used by Server Components, Server Actions and Route Handlers.
# It can be the public API origin or a reachable private URL for this environment.
CERTILYS_BACKEND_URL=https://<API_DOMAIN_FOR_THIS_ENV>

# Comma-separated public image origins accepted by Next Image.
# Set this during the Next.js build when DEV/pre-production uses a Supabase
# Storage hostname that is not already listed in next.config.ts.
# Example: CERTILYS_IMAGE_REMOTE_ORIGINS=https://supabase-dev.example.com
CERTILYS_IMAGE_REMOTE_ORIGINS=
