# Certilys Admin Panel
# Copy this file to .env.local for local development.
# Do not put backend secrets, Supabase keys, Google client secrets, SMTP
# credentials, Bunny keys, or database URLs in the admin panel.

NODE_ENV=development

# Next.js dev server port.
# Start locally with: pnpm dev -p 3001
PORT=3001

# Backend NestJS URL used by server actions.
# Server-only value; preferred for production/deployment.
CERTILYS_BACKEND_URL=http://localhost:4000

# Optional: disable Next telemetry in local/dev/CI.
NEXT_TELEMETRY_DISABLED=1

# Google OAuth notes:
# - GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET belong in certilys-backend, not here.
# - Authorized JavaScript origin for local admin panel:
#   http://localhost:3001
# - Authorized redirect URI for admin Google login:
#   http://localhost:3001/auth/google/callback
